<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.jpmand.openprojectideaintegraiton</id>
    <name>OpenProject Integration</name>
    <vendor>jpmand</vendor>
    <description><![CDATA[
        <p>Work with <a href="https://www.openproject.org">OpenProject</a> work packages without leaving the IDE.</p>
        <ul>
            <li>An <b>OpenProject</b> task server for <i>Tools | Tasks &amp; Contexts</i>: open, switch and close work packages as tasks, and log time.</li>
            <li>A work package table with configurable columns, sorting, search and filters.</li>
            <li>A work package page with description, activity, relations and files.</li>
        </ul>
        <p>Requires the <i>Issue Trackers</i> plugin. Configure the server in <i>Settings | Tools | Tasks | Servers</i> with an OpenProject API token.</p>
    ]]></description>

    <dependencies>
        <plugin id="com.intellij.modules.platform"/>
        <plugin id="com.intellij.tasks"/>
        <module name="intellij.platform.tasks"/>
        <module name="intellij.platform.tasks.impl"/>
        <module name="intellij.platform.vcs.impl"/>
        <module name="intellij.libraries.ktor.client"/>
    </dependencies>

    <resource-bundle>messages.OpenProjectBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="OpenProject" displayType="BALLOON" key="notification.group.name"/>
        <tasks.repositoryType implementation="com.github.jpmand.openprojectideaintegraiton.tasks.OpenProjectRepositoryType"/>

        <virtualFileSystem key="openproject"
                           implementationClass="com.github.jpmand.openprojectideaintegraiton.vfs.OpenProjectVirtualFileSystem"/>
        <fileEditorProvider implementation="com.github.jpmand.openprojectideaintegraiton.ui.WorkPackageListEditorProvider"/>
        <fileEditorProvider implementation="com.github.jpmand.openprojectideaintegraiton.ui.WorkPackageDetailEditorProvider"/>
        <fileIconProvider implementation="com.github.jpmand.openprojectideaintegraiton.ui.OpenProjectFileIconProvider"/>
    </extensions>

    <actions resource-bundle="messages.OpenProjectBundle">
        <action id="OpenProject.OpenWorkPackages" class="com.github.jpmand.openprojectideaintegraiton.actions.OpenWorkPackagesAction"
                icon="/icons/openproject.svg"/>
        <action id="OpenProject.OpenActiveWorkPackage" class="com.github.jpmand.openprojectideaintegraiton.actions.OpenActiveWorkPackageAction"/>
        <action id="OpenProject.LogTime" class="com.github.jpmand.openprojectideaintegraiton.actions.LogTimeAction"/>
        <action id="OpenProject.OpenWorkPackage" class="com.github.jpmand.openprojectideaintegraiton.actions.OpenWorkPackageAction"/>
        <action id="OpenProject.OpenInBrowser" class="com.github.jpmand.openprojectideaintegraiton.actions.OpenWorkPackageInBrowserAction"
                icon="AllIcons.General.Web"/>
        <action id="OpenProject.CopyLink" class="com.github.jpmand.openprojectideaintegraiton.actions.CopyWorkPackageLinkAction"
                icon="AllIcons.Actions.Copy"/>
        <action id="OpenProject.StartWorking" class="com.github.jpmand.openprojectideaintegraiton.actions.StartWorkingAction"
                icon="AllIcons.Actions.Execute"/>
        <action id="OpenProject.Refresh" class="com.github.jpmand.openprojectideaintegraiton.actions.RefreshAction"/>

        <group id="OpenProject.ToolsMenu" popup="true" icon="/icons/openproject.svg">
            <reference ref="OpenProject.OpenWorkPackages"/>
            <reference ref="OpenProject.OpenActiveWorkPackage"/>
            <reference ref="OpenProject.LogTime"/>
            <add-to-group group-id="ToolsMenu" anchor="after" relative-to-action="tasks.group"/>
        </group>
        <group id="OpenProject.TaskActions">
            <separator/>
            <reference ref="OpenProject.OpenWorkPackages"/>
            <reference ref="OpenProject.OpenActiveWorkPackage"/>
            <reference ref="OpenProject.LogTime"/>
            <add-to-group group-id="task.actions" anchor="last"/>
        </group>
        <group id="OpenProject.WorkPackageToolbar">
            <reference ref="OpenProject.Refresh"/>
            <separator/>
            <reference ref="OpenProject.StartWorking"/>
            <reference ref="OpenProject.LogTime"/>
            <separator/>
            <reference ref="OpenProject.OpenInBrowser"/>
            <reference ref="OpenProject.CopyLink"/>
        </group>
        <group id="OpenProject.WorkPackagePopup">
            <reference ref="OpenProject.OpenWorkPackage"/>
            <reference ref="OpenProject.StartWorking"/>
            <reference ref="OpenProject.LogTime"/>
            <separator/>
            <reference ref="OpenProject.OpenInBrowser"/>
            <reference ref="OpenProject.CopyLink"/>
        </group>
    </actions>
</idea-plugin>
